{
  "name": "prettier-plugin-nginx",
  "version": "2.0.0",
  "description": "NGINX configuration plugin for Prettier",
  "author": "Joe Dean <joe@joedean.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/jxddk/prettier-plugin-nginx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxddk/prettier-plugin-nginx.git"
  },
  "bugs": {
    "url": "https://github.com/jxddk/prettier-plugin-nginx/issues"
  },
  "keywords": [
    "nginx",
    "openresty",
    "prettier",
    "prettier-plugin",
    "configuration",
    "format",
    "autoformat",
    "autoformatter"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "test:update": "UPDATE_FIXTURES=1 node --test \"test/fixtures.test.ts\"",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=90 \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "prettier": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
